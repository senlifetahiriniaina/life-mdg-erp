APP_NAME=WideHalo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost:3000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ─── API BACKEND (widehalo-erp-api) ───────────────────────────────────────────
# URL of the widehalo-erp-api instance
API_URL=http://localhost:8000
VITE_API_URL=http://localhost:8000/api/v1

# ─── SESSION / CACHE ──────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── FRONTEND BUILD ───────────────────────────────────────────────────────────
VITE_APP_NAME="WideHalo ERP"
NODE_AUTH_TOKEN=
