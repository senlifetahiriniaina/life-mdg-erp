{
  "manifest_version": 3,
  "name": "WideHalo Timer",
  "version": "1.0.0",
  "description": "Start/stop timesheet timers from any web page and sync them to WideHalo ERP.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "WideHalo Timer",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms",
    "activeTab",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}
