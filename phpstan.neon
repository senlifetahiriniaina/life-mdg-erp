includes:
    - vendor/nunomaduro/larastan/extension.neon

parameters:
    paths:
        - app
        - Modules/Core/app
        - Modules/CRM/app
        - Modules/HR/app
        - Modules/Inventory/app
        - Modules/Inventory/database/factories
        - Modules/Accounting/app
        - Modules/Accounting/database/factories
        - Modules/Projects/app
        - Modules/Projects/database/factories
        - Modules/Manufacturing/app
        - Modules/Manufacturing/database/factories
        - Modules/POS/app
        - Modules/POS/database/factories
        - Modules/Ecommerce/app
        - Modules/Ecommerce/database/factories
        - Modules/Helpdesk/app
        - Modules/Documents/app
        - Modules/Documents/database/factories
        - Modules/BI/app
        - Modules/BI/database/factories
        - Modules/Email/app
        - Modules/Email/database/factories
        - Modules/WhatsApp/app
    level: 6
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # Existing: undefined property on API Resources (dynamic fields via toArray)
        - '#Access to an undefined property Modules\\.*\\Http\\Resources\\.*Resource::#'
        # Eloquent relationship methods — Larastan resolves these; explicit generics add noise
        - '#generic class Illuminate\\Database\\Eloquent\\Relations\\(HasMany|HasOne|BelongsTo|BelongsToMany|HasManyThrough|HasOneThrough|MorphTo|MorphOne|MorphMany|MorphToMany) does not specify its types#'
        # HasFactory generic TFactory — resolved automatically by Larastan
        - '#uses generic trait Illuminate\\Database\\Eloquent\\Factories\\HasFactory but does not specify its types: TFactory#'
        # toArray() / return array — annotating value type on all Resources/arrays is excessive
        - '#return type has no value type specified in iterable type array\.#'
        # Parameters typed as array without value type (AI services, service classes, sync)
        - '#has parameter \$.+ with no value type specified in iterable type array\.#'
        # Collection return types without generic params — annotating <K,V> everywhere is noisy
        - '#return type with generic class Illuminate\\(Database\\Eloquent\\Collection|Support\\Collection) (does not|but does not) specify#'
        # collect() with untyped arrays triggers template resolution warnings
        - '#Unable to resolve the template type T(Key|Value|FlatMapKey|FlatMapValue) in call to (function collect|method Illuminate\\Support\\Collection)#'
        # Stub resource controllers generated by nwidart/laravel-modules — not real endpoints
        - '#Method Modules\\[A-Za-z]+\\Http\\Controllers\\[A-Za-z]+Controller::(index|create|store|show|edit|update|destroy)\(\) has no return type specified\.#'
        - '#Method Modules\\[A-Za-z]+\\Http\\Controllers\\[A-Za-z]+Controller::(show|edit|update|destroy)\(\) has parameter \$id with no type specified\.#'
        # view-string: stub module web controllers reference view names not yet created
        - '#Parameter \#1 \$view of function view expects view-string\|null, string given\.#'
        # property.notFound on Illuminate\Database\Eloquent\Model — Larastan 3.x false positive
        # when accessing relation properties inside whenLoaded closures (e.g. $this->parent->id)
        - '#Access to an undefined property Illuminate\\Database\\Eloquent\\Model::#'
        # Unresolvable closure types in Collection::map / Paginator::through with un-typed closures
        - '#Parameter \#1 \$callback of method Illuminate\\(Database\\Eloquent\\Collection|Pagination\\AbstractPaginator)<.+>::(map|through)\(\) contains unresolvable type\.#'
        - '#Return type of call to method Illuminate\\(Database\\Eloquent\\Collection|Pagination\\AbstractPaginator)<.+>::(map|through)\(\) contains unresolvable type\.#'
        # nullsafe.neverNull — Larastan 3.x false positives: ?->xxx ?? default where object CAN be null
        # (Collection::get returns null for missing keys; BelongsTo relation can be null, etc.)
        - '#Using nullsafe property access "\?->.+" on left side of \?\? is unnecessary\.#'
        # Stripe PHP SDK v20 uses very strict typed stubs that don't accept literal array shapes
        - '#Parameter \#1 \$params of method Stripe\\Service\\PaymentIntentService::create\(\) expects#'
        # $logAttributes static string[] — Larastan/Spatie pattern, value type annotation adds noise
        - '#Property .+::\$logAttributes type has no value type specified in iterable type array\.#'
        # AppServiceProvider $policies array
        - '#Property App\\Providers\\AppServiceProvider::\$policies type has no value type specified in iterable type array\.#'
        # AIService $providers array of AIProvider instances
        - '#Property Modules\\Core\\Services\\AI\\AIService::\$providers type has no value type specified in iterable type array\.#'
        # HasMany/BelongsTo covariance — Larastan 3.x limitation: $this(Model) vs declared Model in generics
        - '#but returns .+HasMany.+, \$this\(.+\)>\.#'
        # Traits only used in tests are not analysed when tests are excluded from paths
        - '#Trait .+ is used zero times and is not analysed\.#'
        # HR/BI/Email services use app('ai') bound to AIService — PHPDoc uses legacy App\Services namespace
        - '#PHPDoc tag @var for variable \$ai contains unknown class App\\Services\\AIService\.#'
        - '#Call to method \w+\(\) on an unknown class App\\Services\\AIService\.#'
        # Carbon/DateTime nullsafe on non-nullable — Larastan false positive with casts() method form
        - '#Using nullsafe method call on non-nullable type Carbon\\Carbon\.#'
        - '#Using nullsafe method call on non-nullable type DateTime\.#'
        # Eloquent relationship return type covariance — Larastan 3.x $this() narrowing limitation
        - '#Method Modules\\(Inventory|Accounting|Manufacturing|HR)\\Models\\.+::.+\(\) should return Illuminate\\Database\\Eloquent\\Relations\\.+#'
        # Accounting open-banking: relations registered dynamically, not visible to static analysis
        - '#Relation .openBankingConnections. is not found in#'
        - '#Relation .createdBy. is not found in#'
        # HR Employee: $name/$total set dynamically in query select() clauses
        - '#Access to an undefined property Modules\\HR\\Models\\Employee::\$(name|total)\.#'
        # All module factories: extend generic Factory but don't specify TModel — Larastan resolves at runtime
        - '#extends generic class Illuminate\\Database\\Eloquent\\Factories\\Factory but does not specify its types: TModel#'
        # Accounting bank models: dynamic connection()/feed() return types resolved at runtime via config
        - '#Method Modules\\Accounting\\Models\\AccBankFeed::connection\(\) should return#'
        - '#Method Modules\\Accounting\\Models\\AccBankFeedTransaction::feed\(\) should return#'
        # PerformanceAppraisal factory: runtime resolution via newFactory() override
        - '#Method Modules\\HR\\Models\\PerformanceAppraisal::newFactory\(\) has .+#'
        - '#Call to static method new\(\) on an unknown class .+PerformanceAppraisalFactory\.#'
        # Ecommerce/CRM: ternary/strict-comparison false positives on mixed-typed Eloquent query results
        - '#Ternary operator condition is always true\.#'
        - '#Strict comparison using !== between mixed and null will always#'
        - '#Expression on left side of \?\? is not nullable\.#'
        - '#Left side of && is always true\.#'
        # CRM/Inventory: offset on non-empty-list / fixed-shape array — PHPStan false positive
        - '#Offset .+ on .+ on left side of \?\? always exists and is not nullable\.#'
        # BI ExportService: intentional closure use $widget for export pipeline context
        - '#Anonymous function has an unused use \$widget\.#'
        # Accounting/Inventory/Manufacturing: Builder::where() third param typed as mixed internally
        - '#Parameter \#3 \$value of method Illuminate\\Database\\Eloquent\\Builder.+::where\(\) expects .+, mixed given\.#'
        # Unresolvable callback/array return types in collection/array pipelines
        - '#Anonymous function should return .+ but returns .+#'
        - '#Return type of call to function array_values contains unresolvable type\.#'
        - '#Parameter \#1 \$array of function array_values contains unresolvable type\.#'
        - '#Unable to resolve the template type TMapValue in call to method#'
        # POS PaymentTerminal: computed @property for terminal status via accessor
        - '#Class Modules\\POS\\Models\\PaymentTerminal has PHPDoc tag @property for#'
        # Accounting controllers: undefined methods on dynamic open-banking query builders
        - '#Call to an undefined method Illuminate\\Database\\Eloquent\\Model::isActive\(\)\.#'
        - '#Call to an undefined method Modules\\(Accounting|Ecommerce|CRM|Manufacturing|Helpdesk|Inventory)\\.+::#'
        # Accounting/Inventory: Builder::whereDate() / where() with Stringable or mixed value
        - '#Parameter \#3 \$value of method Illuminate\\Database\\Eloquent\\Builder.+::where(Date)?\(\) expects .+, .+ given\.#'
        # Accounting BankTransactionController: wrong overload / argument type in BankReconciliationService
        - '#Method .+BankReconciliationService::matchTransaction\(\) invoked with 3 parameters, 2 required\.#'
        - '#Parameter \#1 \$statement of method .+BankReconciliationService::autoMatch\(\) expects .+, .+ given\.#'
        # Manufacturing SchedulingController: Collection::map callback return type covariance
        - '#Parameter \#1 \$callback of method Illuminate\\(Database\\Eloquent|Support)\\Collection.+::map\(\) expects callable.+, Closure.+ given\.#'
        # CRM/Inventory: access to property on dynamic Eloquent models or services
        - '#Access to an undefined property Modules\\(CRM|Ecommerce|Inventory|Manufacturing)\\.+::#'
    excludePaths:
        - app/Providers/TelescopeServiceProvider.php
