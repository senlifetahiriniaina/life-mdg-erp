APP_NAME="Life MDG ERP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

BCRYPT_ROUNDS=12
SANCTUM_TOKEN_EXPIRATION=43200

# ─── JWT Authentication ─────────────────────────────────────────────────────
JWT_SECRET=${APP_KEY}
JWT_ACCESS_TOKEN_EXPIRY=900
JWT_REFRESH_TOKEN_EXPIRY=2592000

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ─── SECURITY (CORS / Metrics) ────────────────────────────────────────────────
# Comma-separated allowed browser origins. Required in production — do NOT use
# "*" (rejected together with credentials). Example:
#   CORS_ALLOWED_ORIGINS=https://app.lifemdg.com
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS_PATTERNS=
# Prometheus /api/metrics bearer token. Fails closed in production when empty.
METRICS_TOKEN=

# ─── DATABASE – Central DB (tenancy management) ───────────────────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=life_mdg_erp
DB_USERNAME=life_mdg
DB_PASSWORD=secret
# TLS to the database (set DB_SSL_CA to enable; DB_SSL_VERIFY defaults to true).
DB_SSL_CA=
DB_SSL_CERT=
DB_SSL_KEY=
DB_SSL_VERIFY=true

# ─── CACHE / SESSION / QUEUE / BROADCAST ──────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
# Must stay true in any environment served over HTTPS (i.e. everywhere except
# plain-HTTP local dev) — unset previously left the session cookie non-secure.
SESSION_SECURE_COOKIE=true
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=reverb

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ─── MAIL ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@lifemdg.com"
MAIL_FROM_NAME="${APP_NAME}"

# ─── STORAGE ──────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ─── REVERB (WebSockets) ──────────────────────────────────────────────────────
REVERB_APP_ID=life_mdg
REVERB_APP_KEY=app-key
REVERB_APP_SECRET=app-secret
REVERB_HOST=localhost
REVERB_PORT=8080
REVERB_SCHEME=http
# Comma-separated WebSocket origins (defaults to CORS_ALLOWED_ORIGINS / APP_URL).
REVERB_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# ─── MEILISEARCH ──────────────────────────────────────────────────────────────
SCOUT_DRIVER=meilisearch
MEILISEARCH_HOST=http://localhost:7700
MEILISEARCH_KEY=

# ─── AI PROVIDERS ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
# DeepSeek auto-hébergé (Ollama, voir docker-compose.deepseek.yml) — provider
# additionnel optionnel, sélectionnable via AI_DEFAULT_PROVIDER=deepseek ou un
# override module_providers dans config/ai.php. http://deepseek:11434/v1 en
# contexte docker-compose, http://localhost:11434/v1 en local hors conteneur.
DEEPSEEK_BASE_URL=http://localhost:11434/v1
DEEPSEEK_MODEL=deepseek-r1:7b
AI_DEFAULT_PROVIDER=anthropic

# ─── WHATSAPP BUSINESS ────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# ─── OPEN BANKING WEBHOOKS ────────────────────────────────────────────────────
PLAID_WEBHOOK_SECRET=
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox

NORDIGEN_WEBHOOK_SECRET=
NORDIGEN_SECRET_ID=
NORDIGEN_SECRET_KEY=

BRIDGE_WEBHOOK_SECRET=
BRIDGE_CLIENT_ID=
BRIDGE_CLIENT_SECRET=

TRUELAYER_WEBHOOK_SECRET=
TRUELAYER_CLIENT_ID=
TRUELAYER_SECRET=

WEBHOOK_RETRY_MAX_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_SECONDS=300

# ─── BACKUP STRATEGY ──────────────────────────────────────────────────────────
BACKUP_DISK=s3
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30
BACKUP_S3_BUCKET=${AWS_BUCKET}
BACKUP_S3_PREFIX=backups/daily
BACKUP_S3_ENCRYPTION=AES256
BACKUP_S3_STORAGE_CLASS=STANDARD_IA
BACKUP_LOCAL_PATH=backups
BACKUP_NOTIFICATIONS_ENABLED=true
BACKUP_NOTIFICATION_CHANNELS=log,slack
BACKUP_SLACK_WEBHOOK=
BACKUP_VERIFICATION_ENABLED=true
BACKUP_VERIFICATION_SCHEDULE="0 4 */7 * *"
BACKUP_PITR_ENABLED=false
BACKUP_PITR_SCHEDULE="0 * * * *"
BACKUP_PITR_RETENTION_HOURS=72

# ─── TENANCY ──────────────────────────────────────────────────────────────────
TENANCY_DEFAULT_DB_HOST=127.0.0.1
TENANCY_DEFAULT_DB_PORT=3306
TENANCY_DEFAULT_DB_USERNAME=life_mdg
TENANCY_DEFAULT_DB_PASSWORD=secret

# ─── ENABLED MODULES (comma-separated; used for distributed deployment) ───────
ENABLED_MODULES=Core,AI,Security,AuditLog,API,Integration,Validation,Shared,Settings,Setup,Workflow,Calendar,Accounting,CRM,Sales,Inventory,Logistics,Achats,BI,Analytics,Reporting,Strategy,HR,Payroll,Timesheets,Projects,Helpdesk

# ─── MULTI-SERVER ROUTING (used by API Gateway; leave blank for single-node) ──
CRM_SERVER_HOST=
FINANCE_SERVER_HOST=
OPS_SERVER_HOST=
COMMS_SERVER_HOST=
ANALYTICS_SERVER_HOST=

# ─── STRIPE / PAYMENTS ────────────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ─── GOOGLE 2FA ───────────────────────────────────────────────────────────────
GOOGLE2FA_ENABLED=true

# ─── TELESCOPE (dev only — set false in production) ──────────────────────────
TELESCOPE_ENABLED=true

# ─── MONITORING ───────────────────────────────────────────────────────────────
# Leave blank in local dev (no auth on /api/metrics)
# Set a long random token in production and configure your Prometheus scrape config:
#   bearer_token: <value>
METRICS_TOKEN=

# ─── SENTRY ERROR TRACKING ────────────────────────────────────────────────────
# Get your DSN from https://sentry.io/
# SENTRY_DSN is required to enable error tracking in production
SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
SENTRY_SEND_DEFAULT_PII=false

# ─── GRAFANA (docker-compose.monitoring.yml) ──────────────────────────────────
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_SMTP_ENABLED=false
GRAFANA_SMTP_HOST=mailpit:1025
GRAFANA_SMTP_FROM=alerts@lifemdg.com

# ─── ALERTMANAGER ─────────────────────────────────────────────────────────────
ALERT_EMAIL=ops@lifemdg.com
CRITICAL_EMAIL=oncall@lifemdg.com
