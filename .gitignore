Thumbs.db
/.idea
/.vscode
/.fleet
/.claude

# AWS Lightsail deployment config (scripts/lightsail-deploy.sh) — real values
# and the downloaded default SSH private key, never committed.
/deploy/lightsail.config
/deploy/lightsail-default-key-*.pem

# GCP deployment config (scripts/gcp-deploy.sh) — real values, never
# committed. No private-key pattern needed here: unlike Lightsail, gcloud
# manages its own ephemeral SSH key pair outside this repo by default.
/deploy/gcp.config

# Hetzner Cloud deployment config (scripts/hetzner-deploy.sh) — real values
# (including the Hetzner DNS Console API token), never committed. No
# private-key pattern needed: the SSH key itself must already be registered
# in the Hetzner Cloud project before this repo ever touches it.
/deploy/hetzner.config

# GitHub token file written by scripts/deploy.sh from .env's optional
# GITHUB_TOKEN, mounted into the Docker build as a BuildKit secret
# (docker-compose.prod.yml) to authenticate composer install against the
# GitHub API — never committed, chmod 600.
/deploy/github_token.secret
